@startuml finds-package
package src {
  [App]
  [MapView]
  [edgeio]
}
package shared {
  [nasa]
  [scoring]
  [validation]
  [tagConcept] <<conceptual>>
}
package api.worker {
  [index]
}
[App] --> [nasa]
[index] --> [nasa]
[index] --> [scoring]
note right of [tagConcept]
  Conceptual types only;
  not imported by Worker pipeline
end note
@enduml
