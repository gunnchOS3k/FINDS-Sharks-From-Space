{
  "name": "finds-sharks-from-space",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "FINDS — Sharks From Space. Exploratory NASA ocean-observation visualization with Gemini-assisted scoring.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "worker:dev": "wrangler dev --config api/worker/wrangler.toml --port 8787",
    "worker:deploy": "wrangler deploy --config api/worker/wrangler.toml",
    "diagrams": "node scripts/render-uml.mjs",
    "diagrams:check": "node scripts/render-uml.mjs --check",
    "assets": "node scripts/generate-assets.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run test:integration && npm run diagrams:check && npm run build",
    "android:sync": "npm run build && npx cap sync android",
    "android:build": "node scripts/android-build.mjs",
    "android:install": "node scripts/android-install.mjs",
    "android:launch": "node scripts/android-launch.mjs",
    "android:smoke": "node scripts/android-smoke.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/app": "^7.1.0",
    "@capacitor/core": "^7.4.3",
    "@capacitor/status-bar": "^7.0.3",
    "@deck.gl/aggregation-layers": "^9.1.15",
    "@deck.gl/core": "^9.1.15",
    "@deck.gl/geo-layers": "^9.1.15",
    "@deck.gl/layers": "^9.1.15",
    "@deck.gl/react": "^9.1.15",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@capacitor/cli": "^7.4.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.18.0",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.0.2",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.33.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.40.0",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.33.1"
  }
}
